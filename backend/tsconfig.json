{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,

    /* Output */
    "outDir": "./dist",
    "rootDir": "./",

    /* Type definitions */
    "types": ["node"]
  },
  "include": ["netlify", "src"],
  "exclude": ["node_modules", "dist"]
}
